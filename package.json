{
  "name": "tickmark",
  "version": "0.1.1",
  "description": "TickMark CLI — render markdown to HTML with GFM tables, and toggle checkboxes that write back to the source .md file.",
  "license": "MIT",
  "keywords": [
    "markdown",
    "preview",
    "checkbox",
    "gfm",
    "table",
    "cli"
  ],
  "bin": {
    "tickmark": "bin/tickmark.js",
    "timd": "bin/tickmark.js"
  },
  "files": [
    "bin/",
    "out/",
    "media/",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "build": "npm run compile",
    "release": "sh scripts/release.sh",
    "link": "npm run build && npm link"
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
